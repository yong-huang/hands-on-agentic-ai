{
  "schema_version": 2,
  "diagram_type": "workflow",
  "meta": {
    "title": "ReAct 循环: Thought → Action → Observation",
    "locale": "zh-CN",
    "quality_profile": "showcase",
    "legend": {
      "mode": "hidden"
    },
    "viewBox": [
      1240,
      560
    ]
  },
  "lanes": [
    {
      "id": "loop",
      "label": "ReAct 主循环"
    },
    {
      "id": "guard",
      "label": "容错重试"
    },
    {
      "id": "done",
      "label": "终止"
    }
  ],
  "mainPath": [
    "question",
    "llm",
    "parse",
    "exec"
  ],
  "nodes": [
    {
      "id": "question",
      "lane": "loop",
      "col": 0,
      "type": "external",
      "label": "用户问题",
      "sublabel": "输入",
      "width": 130
    },
    {
      "id": "llm",
      "lane": "loop",
      "col": 1,
      "type": "cloud",
      "label": "LLM 推理",
      "sublabel": "Thought: 下一步做什么",
      "tag": "每步 1 次调用",
      "width": 150
    },
    {
      "id": "parse",
      "lane": "loop",
      "col": 2,
      "type": "backend",
      "label": "解析输出",
      "sublabel": "Thought / Action / Answer",
      "width": 150
    },
    {
      "id": "exec",
      "lane": "loop",
      "col": 3,
      "type": "backend",
      "label": "执行工具",
      "sublabel": "查注册表 → Observation",
      "tag": "失败也回喂",
      "width": 150
    },
    {
      "id": "answer",
      "lane": "done",
      "col": 4,
      "type": "database",
      "label": "Final Answer",
      "sublabel": "解析到 Answer 即退出",
      "width": 150
    },
    {
      "id": "retry",
      "lane": "guard",
      "col": 2,
      "type": "security",
      "label": "错误回喂重试",
      "sublabel": "max_steps=6 兜底",
      "width": 150
    }
  ],
  "edges": [
    {
      "id": "question-llm",
      "from": "question",
      "to": "llm"
    },
    {
      "id": "llm-parse",
      "from": "llm",
      "to": "parse",
      "label": "Thought + Action 文本",
      "variant": "emphasis"
    },
    {
      "id": "parse-exec",
      "from": "parse",
      "to": "exec",
      "label": "Action: 工具(入参)",
      "variant": "emphasis"
    },
    {
      "id": "exec-llm",
      "from": "exec",
      "to": "llm",
      "label": "Observation 回喂 (循环)",
      "role": "return",
      "variant": "emphasis",
      "route": "up-channel",
      "fromSide": "top",
      "toSide": "top"
    },
    {
      "id": "parse-answer",
      "from": "parse",
      "to": "answer",
      "label": "Answer: 终止",
      "variant": "emphasis"
    },
    {
      "id": "parse-retry",
      "from": "parse",
      "to": "retry",
      "label": "格式不符",
      "variant": "security",
      "role": "error"
    },
    {
      "id": "retry-llm",
      "from": "retry",
      "to": "llm",
      "label": "带回错误重试",
      "variant": "dashed",
      "role": "error"
    }
  ],
  "cards": [
    {
      "dot": "cyan",
      "title": "循环怎么转",
      "items": [
        "Thought：模型说下一步做什么",
        "Action：选工具并入参，本地执行",
        "Observation：结果回喂，直到模型给出 Answer"
      ]
    },
    {
      "dot": "rose",
      "title": "工程细节",
      "items": [
        "qwen3.5 的 <think> 标签要先剥掉再解析",
        "兼容 Thought/Thinking 等变体写法",
        "max_steps=6 兜底，防止无限循环"
      ]
    }
  ]
}