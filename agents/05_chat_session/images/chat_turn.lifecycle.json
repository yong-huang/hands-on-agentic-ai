      "variant": "security",
      "fromSide": "left",
      "toSide": "left",
      "via": [
        [
          20,
          307
        ],
        [
          20,
          157
        ]
      ],
      "labelAt": [
        160,
        307
      ]
    },
    {
      "id": "replying-exit",
      "from": "replying",
      "to": "exit",
      "label": "退出会话",
      "variant": "dashed",
      "fromSide": "bottom",
      "toSide": "top",
      "route": "straight",
      "labelDy": 34
    }
  ],
  "cards": [
    {
      "dot": "emerald",
      "title": "多轮的本质",
      "items": [
        "模型本身无记忆——每一轮都重发全部历史",
        "对话状态就是 messages 数组的增长",
        "回复有效（长度>5）才追加，失败即回滚"
      ]
    },
    {
      "dot": "amber",
      "title": "上下文的代价",
      "items": [
        "历史全保留：最简单但 token 随轮次线性增长",
        "滑动窗口 / 摘要压缩是后续项目的改进方向",
        "/clear 重建会话是手动止血手段"
      ]
    }
  ]
}