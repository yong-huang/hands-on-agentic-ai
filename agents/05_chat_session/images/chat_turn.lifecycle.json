{
  "schema_version": 1,
  "diagram_type": "lifecycle",
  "meta": {
    "title": "多轮对话的一轮生命周期",
    "locale": "zh-CN",
    "quality_profile": "showcase",
    "viewBox": [
      1020,
      630
    ]
  },
  "lanes": [
    {
      "id": "main",
      "label": "会话轮次"
    },
    {
      "id": "waiting",
      "label": "异常恢复"
    },
    {
      "id": "terminal",
      "label": "退出"
    }
  ],
  "states": [
    {
      "id": "idle",
      "type": "start",
      "label": "等待输入",
      "sublabel": "input() 阻塞",
      "lane": "main",
      "col": 0,
      "step": "01"
    },
    {
      "id": "building",
      "type": "active",
      "label": "构建 messages",
      "sublabel": "system + 历史 + 新输入",
      "lane": "main",
      "col": 1,
      "step": "02"
    },
    {
      "id": "calling",
      "type": "waiting",
      "label": "等待 API 响应",
      "sublabel": "POST /api/chat",
      "lane": "main",
      "col": 2,
      "step": "03"
    },
    {
      "id": "replying",
      "type": "active",
      "label": "回复并记录",
      "sublabel": "历史 +2",
      "lane": "main",
      "col": 3,
      "step": "04"
    },
    {
      "id": "rollback",
      "type": "failure",
      "label": "无效回复",
      "sublabel": "messages.pop() 回滚",
      "lane": "waiting",
      "col": 0
    },
    {
      "id": "exit",
      "type": "success",
      "label": "退出",
      "sublabel": "/exit · Ctrl+C / Ctrl+D",
      "lane": "terminal",
      "col": 1
    }
  ],
  "transitions": [
    {
      "id": "idle-building",
      "from": "idle",
      "to": "building",
      "variant": "default"
    },
    {
      "id": "building-calling",
      "from": "building",
      "to": "calling",
      "variant": "emphasis"
    },
    {
      "id": "calling-replying",
      "from": "calling",
      "to": "replying",
      "variant": "emphasis"
    },
    {
      "id": "replying-idle",
      "from": "replying",
      "to": "idle",
