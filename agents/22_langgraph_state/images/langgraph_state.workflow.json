  "cards": [
    {
      "dot": "cyan",
      "title": "LangGraph 三要素",
      "items": [
        "State(TypedDict): 全局共享, 节点返回增量",
        "Node: 读状态→干活→写回",
        "Conditional Edge: 按状态选下一个节点"
      ]
    },
    {
      "dot": "amber",
      "title": "循环控制",
      "items": [
        "评审不通过回炉修订, 计数器防死循环",
        "真机实测: 首稿 8 分直接定稿(条件边通过支)",
        "demo 实测: 7 分→修订→9 分(条件边循环支)"
      ]
    }
  ]
