    {
      "from": "splitter",
      "to": "chunks",
      "label": "小片合并",
      "classification": "overlap 回填",
      "variant": "emphasis"
    }
  ],
  "cards": [
    {
      "dot": "emerald",
      "title": "切分质量三要素",
      "items": [
        "递归降级：段落→句子→字符，语义边界优先",
        "overlap 回填：关键句不被块边界切断",
        "块带元数据：来源文件 + 序号，答案可溯源"
      ]
    },
    {
      "dot": "amber",
      "title": "真实坑",
      "items": [
        "Chrome 系 PDF 的汉字常是兼容形式，必须 NFKC 归一化",
        "块太大带噪音、块太小缺上下文——120 字符是本实验的折中",
        "产出将作为项目 21 向量索引的输入"
      ]
    }
  ]
}