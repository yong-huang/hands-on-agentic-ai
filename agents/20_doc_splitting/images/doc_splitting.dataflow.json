      "labelAt": [
        265,
        157
      ]
    },
    {
      "from": "txt",
      "to": "loader",
      "label": "文本",
      "classification": "utf-8",
      "variant": "default",
      "labelAt": [
        265,
        271
      ]
    },
    {
      "from": "pdf",
      "to": "loader",
      "label": "文档",
      "classification": "逐页提取",
      "variant": "security",
      "labelAt": [
        265,
        385
      ]
    },
    {
      "from": "loader",
      "to": "splitter",
      "label": "递归降级",
      "classification": "分隔符优先级",
      "variant": "emphasis"
