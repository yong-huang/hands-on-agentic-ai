{
  "schema_version": 1,
  "diagram_type": "architecture",
  "meta": {
    "title": "工具注册表（Registry）模式",
    "locale": "zh-CN",
    "quality_profile": "showcase",
    "viewBox": [
      640,
      540
    ]
  },
  "layout": {
    "mode": "grid",
    "cols": 2,
    "gapX": 90,
    "gapY": 80
  },
  "components": [
    {
      "id": "deco",
      "type": "messagebus",
      "label": "@tool_def 装饰器",
      "sublabel": "注解 + docstring → schema",
      "row": 0,
      "col": 0
    },
    {
      "id": "registry",
      "type": "database",
      "label": "ToolRegistry",
      "sublabel": "dict: name → ToolDefinition",
      "row": 1,
      "col": 0
    },
    {
      "id": "ollama",
      "type": "cloud",
      "label": "qwen3.8",
      "sublabel": "tool_calls 输出",
      "row": 1,
      "col": 1
    },
    {
      "id": "agent",
      "type": "backend",
      "label": "Agent 循环",
      "sublabel": "dispatch(name, args)",
      "row": 2,
      "col": 1
    },
    {
      "id": "tools",
      "type": "backend",
      "label": "工具函数 ×4",
      "sublabel": "calculator / weather / …",
      "row": 2,
      "col": 0
    }
  ],
  "connections": [
    {
      "id": "deco-registry",
      "from": "deco",
      "to": "registry",
      "label": "注册",
      "variant": "emphasis",
      "labelAt": [
        195,
        230
      ]
    },
    {
      "id": "registry-ollama",
      "from": "registry",
      "to": "ollama",
      "label": "get_tools_schema()",
      "variant": "emphasis",
      "labelAt": [
        480,
        230
      ]
    },
    {
      "id": "ollama-agent",
      "from": "ollama",
      "to": "agent",
      "label": "tool_calls",
      "variant": "emphasis",
      "labelAt": [
        575,
        170
      ]
    },
    {
      "id": "agent-tools",
      "from": "agent",
      "to": "tools",
      "label": "dispatch",
      "variant": "emphasis",
      "labelAt": [
        355,
        300
      ]
    },
    {
      "id": "tools-registry",
      "from": "tools",
      "to": "registry",
      "label": "执行结果",
      "variant": "dashed",
      "labelAt": [
        225,
        311
      ]
    }
  ],
  "cards": [
    {
      "dot": "cyan",
      "title": "环形协作",
      "items": [
        "Registry 把 schema 给模型 → 模型回 tool_calls",
        "Agent dispatch → Registry 调 handler → 结果回流",
        "环形读法: 沿矩形一圈就是一次完整的工具调用"
      ]
    },
    {
      "dot": "rose",
      "title": "对比项目 11",
      "items": [
        "装饰器注册: 加工具只加一个函数",
        "未知工具返回可用列表, 不崩溃",
        "calculator 正则白名单拦 eval 注入"
      ]
    }
  ]
}